@inherits LayoutComponentBase

<MudThemeProvider @ref="_themeProvider" Theme="_theme" IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIcon Icon="@Icons.Material.Filled.RestaurantMenu" Class="mr-3" />
        <MudText Typo="Typo.h6">Menu Planner</MudText>
        <MudSpacer />
        <MudButton Href="" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.CalendarMonth">Plan</MudButton>
        <MudButton Href="mains" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.DinnerDining">Mains</MudButton>
        <MudButton Href="sides" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.RiceBowl">Sides</MudButton>
        <MudTooltip Text="@(_dark ? "Light mode" : "Dark mode")">
            <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="ToggleDarkAsync" aria-label="Toggle dark mode" />
        </MudTooltip>
        @if (!OperatingSystem.IsBrowser())
        {
            <form method="post" action="logout" data-enhance="false">
                <AntiforgeryToken />
                <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Logout"
                               Color="Color.Inherit" aria-label="Sign out" />
            </form>
        }
    </MudAppBar>
    @if (OperatingSystem.IsBrowser())
    {
        <div class="mp-demo-banner">
            Demo: everything runs in your browser with sample dishes and resets when you reload.
        </div>
    }
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private MudThemeProvider _themeProvider = default!;
    private bool _dark;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#b4532a",
            AppbarBackground = "#b4532a",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#e08a5f",
            AppbarBackground = "#5a2a15",
            Background = "#1c1a19",
            Surface = "#262321",
            DrawerBackground = "#262321",
        },
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Saved choice wins; otherwise follow the device setting.
        var saved = await JS.InvokeAsync<string?>("mpTheme.get");
        _dark = saved is null ? await _themeProvider.GetSystemDarkModeAsync() : saved == "dark";
        StateHasChanged();
    }

    private async Task ToggleDarkAsync()
    {
        _dark = !_dark;
        await JS.InvokeVoidAsync("mpTheme.set", _dark ? "dark" : "light");
    }
}
