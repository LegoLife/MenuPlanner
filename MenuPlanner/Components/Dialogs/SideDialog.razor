<MudDialog>
    <TitleContent>@(Side.Id == 0 ? "Add side" : "Edit side")</TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="Side.Name" Label="Name" Required="true" RequiredError="Name is required"
                          MaxLength="200" AutoFocus="true" Immediate="true" />
            <MudTextField @bind-Value="Side.Notes" Label="Notes" Lines="3" MaxLength="2000" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    /// <summary>A detached copy to edit; returned as the dialog result on save.</summary>
    [Parameter] public Side Side { get; set; } = new();

    private MudForm _form = null!;

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        Side.Name = Side.Name.Trim();
        Side.Notes = string.IsNullOrWhiteSpace(Side.Notes) ? null : Side.Notes.Trim();
        Dialog.Close(DialogResult.Ok(Side));
    }
}
